#!/usr/bin/env python3
"""Add todos to this repo/branch's feature note in the Obsidian vault.

    feature-todo "Do the thing" "Another thing"   # appends "- [ ] ..." under ## Todos, prints the note path
    feature-todo --path                            # only prints (and creates) the note path

The note is <vault>/<folder>/<repo>/<branch>.md, the same note the Herdr Notes panel (mods/notes)
shows for this space's branch. Vault: ~/.config/herdr-app/notes.json {"vault", "folder"}, else the vault
Obsidian has open. Run it from inside the repo (any worktree). Exits 2 when there's no vault, repo or branch,
so the caller can fall back to TODO.md.
"""
import datetime, json, os, re, subprocess, sys

def fail(msg):
    print(f"feature-todo: {msg}", file=sys.stderr)
    sys.exit(2)

def load(path):
    try:
        with open(os.path.expanduser(path)) as f:
            return json.load(f)
    except Exception:
        return None

own = load("~/.config/herdr-app/notes.json") or {}
vault = os.path.expanduser(own["vault"]) if own.get("vault") else None
if not vault:
    reg = load("~/Library/Application Support/obsidian/obsidian.json") or load("~/.config/obsidian/obsidian.json") or {}
    vaults = [v for v in (reg.get("vaults") or {}).values() if isinstance(v.get("path"), str)]
    pick = next((v for v in vaults if v.get("open")), None) or max(vaults, key=lambda v: v.get("ts", 0), default=None)
    vault = pick and pick["path"]
if not vault or not os.path.isdir(vault):
    fail("no Obsidian vault found")
folder = str(own.get("folder", "Herdr")).strip("/")

try:
    out = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir", "--abbrev-ref", "HEAD"],
                         capture_output=True, text=True, check=True).stdout.split("\n")
except Exception:
    fail("not in a git repo")
common, branch = out[0].strip(), out[1].strip()
repo = re.sub(r"/\.git/?$|\.git$", "", common).rstrip("/").split("/")[-1]
if not branch or branch == "HEAD":
    fail("detached HEAD, no branch")

slug = lambda s: re.sub(r"^-+|-+$", "", re.sub(r"[\\/:]+", "-", s))
repo_dir = os.path.join(vault, folder, slug(repo))
note = os.path.join(repo_dir, slug(branch) + ".md")
repo_note = os.path.join(repo_dir, slug(repo) + ".md")
os.makedirs(repo_dir, exist_ok=True)

if not os.path.exists(repo_note):
    with open(repo_note, "w") as f:
        f.write(f"---\ntags: [repo]\nrepo: {repo}\n---\n# {repo}\n\nWhat this repo is, how it's run, decisions that outlive a branch.\n\n## Features\n\n")
if not os.path.exists(note):
    today = datetime.date.today().isoformat()
    with open(note, "w") as f:
        f.write(f"---\ntags: [feature]\nrepo: {repo}\nbranch: {branch}\nstatus: active\ncreated: {today}\n---\n"
                f"# {branch}\n\nRepo: [[{slug(repo)}]]\n\n## Todos\n\n## Notes\n\n## Log\n")
    with open(repo_note) as f:
        text = f.read()
    if f"[[{slug(branch)}]]" not in text:
        lines = text.rstrip("\n").split("\n")
        i = next((k for k, l in enumerate(lines) if re.match(r"##\s+Features", l, re.I)), None)
        if i is None:
            lines += ["", f"- [[{slug(branch)}]]"]
        else:
            j = i + 1
            while j < len(lines) and not re.match(r"#{1,2}\s", lines[j]):
                j += 1
            while j > i + 1 and not lines[j - 1].strip():
                j -= 1
            lines[j:j] = ([""] if j == i + 1 else []) + [f"- [[{slug(branch)}]]"]
        with open(repo_note, "w") as f:
            f.write("\n".join(lines) + "\n")

items = [a.strip() for a in sys.argv[1:] if a != "--path" and a.strip()]
if items:
    with open(note) as f:
        lines = f.read().rstrip("\n").split("\n")
    new = [f"- [ ] {t}" for t in items]
    todo = re.compile(r"^\s*[-*] \[[ xX]\]")
    h = next((k for k, l in enumerate(lines) if re.match(r"##\s+Todos", l, re.I)), None)
    if h is None:
        lines += ["", "## Todos", ""] + new
    else:
        end = h + 1
        while end < len(lines) and not re.match(r"#{1,2}\s", lines[end]):
            end += 1
        last = max((k for k in range(h + 1, end) if todo.match(lines[k])), default=None)
        if last is not None:
            lines[last + 1:last + 1] = new
        else:
            at = h + 2 if h + 1 < len(lines) and not lines[h + 1].strip() else h + 1
            block = ([""] if at == h + 1 else []) + new
            if at < len(lines) and lines[at].strip():
                block.append("")
            lines[at:at] = block
    with open(note, "w") as f:
        f.write("\n".join(lines) + "\n")
print(note)
